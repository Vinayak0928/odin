# ==============================================================================
# MRPL Sovereign On-Premise Agentic AI Workbench (SIH26117)
# Mangalore Refinery and Petrochemicals Limited (MRPL)
# Confidential Industrial Intelligence with Open-Weight Multimodal LLMs
# ==============================================================================

# ============================================================
# Air-Gap & Sovereignty Enforcement (SIH26117 Mandatory)
# ============================================================
MRPL_AIRGAP_ENFORCED=true
MRPL_EGRESS_POLICY=0-WAN_STRICT_AIRGAP
ALLOW_EXTERNAL_LLM_APIS=false

# ============================================================
# Open-Weight Local Multimodal & Reasoning LLMs (Ollama / vLLM / llama.cpp)
# ============================================================
# Primary on-premise inference server
LLM_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434/v1
# VLLM_BASE_URL=http://localhost:8000/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# Recommended Open-Weight Industrial Models for MRPL:
# - Vision / P&ID Drawing Inspection: Qwen2.5-VL-7B-Instruct / Qwen2.5-VL-72B-Instruct
# - Industrial Reasoning & HAZOP Logic: DeepSeek-R1-Distill-Qwen-32B / DeepSeek-R1
# - Technical Code & Automation: Qwen2.5-Coder-32B-Instruct
# - General Operations & Turnaround Planning: Llama-3.3-70B-Instruct

# ============================================================
# Industrial Intelligence & Regulatory Compliance
# ============================================================
# Merkle DAG Audit Trail log path
MRPL_AUDIT_LOG_PATH=./data/merkle_audit.jsonl

# Statutory Turnaround & Safety Defaults
DEFAULT_REGULATORY_CODE=OISD-105 / IBR / ASME BPVC / API 510
DEFAULT_REFINERY_UNIT=MRPL-CDU-VDU-101

# ============================================================
# Database & Storage
# ============================================================
DATABASE_URL=sqlite:///./data/app.db
ODYSSEUS_DATA_DIR=./data

# ============================================================
# Auth & Role-Based Access Control (RBAC)
# ============================================================
AUTH_ENABLED=true
APP_BIND=127.0.0.1
APP_PORT=7000

# Department RBAC Profiles:
# - OPERATIONS_TAR: Turnaround planning, blind lists, execution schedules
# - PROCESS_ENGINEERING: Crude distillation assay optimization, heat exchanger duties
# - RELIABILITY_INSPECTION: API 510 vessel remaining life, API 570 piping retirement
# - HSE_SAFETY: P&ID HAZOP audits, ISA-5.1 safety relief inspection, Merkle audits
# - EXECUTIVE_MANAGEMENT: Full refinery oversight & compliance verification

# ============================================================
# Vector RAG & Engineering Document Indexing
# ============================================================
CHROMADB_HOST=localhost
CHROMADB_PORT=8100
EMBEDDING_PROVIDER=local_bge
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# Max drawing / document attachment size (e.g. 50 MB for high-res A0 P&ID scans)
ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=52428800
